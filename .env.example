# API runtime configuration
APP_ENV=development
API_HOST=127.0.0.1
API_PORT=3000

# API browser CORS allowlist (server-only; comma-separated explicit origins)
CORS_ALLOWED_ORIGINS=http://127.0.0.1:8082,http://localhost:8082,http://127.0.0.1:5173,http://localhost:5173

# Customer session (server-only; required explicitly in production)
AUTH_SESSION_SECRET=development-only-session-secret-change-me-32-bytes
AUTH_SESSION_TTL_SECONDS=2592000

# Separate Admin staff session (server-only; no default staff credentials)
STAFF_SESSION_TTL_SECONDS=28800

# Public API endpoints used by frontend bundles. These values are not secrets.
EXPO_PUBLIC_API_URL=http://localhost:3000
VITE_API_URL=http://127.0.0.1:3000
# Set to 1 only for local Expo Go action/network tracing; never use in production.
# EXPO_PUBLIC_DEBUG_LOGS=1

# Native push and EAS Update (public project id, injected into the Customer app build)
# EXPO_PUBLIC_EAS_PROJECT_ID=replace-with-eas-project-id
# For EAS environment `preview`, set EXPO_PUBLIC_API_URL to a public deployed API URL.

# SMS.ru (server-only; not used by phone-only auth, reserved for future SMS notifications)
# SMS_RU_API_ID=replace-with-sms-ru-api-id
# SMS_RU_SENDER=VseProZhar

# PostgreSQL connection (the project's single local database; server-only, never expose to frontend bundles)
# Do not replace with a test database or create another local database.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/vse_pro_zhar_dev

# Local media storage (server-only; uploaded originals are converted to WebP)
MEDIA_DIR=./data/media
MEDIA_PUBLIC_URL=http://127.0.0.1:3000

# Optional iiko adapter (server-only).
# Leave all IIKO_* variables unset to keep checkout fail-closed and fulfillment disabled.
# Local simulator values:
# IIKO_BASE_URL=http://127.0.0.1:4010
# IIKO_API_KEY=vpzh-test-api-key
# IIKO_APP_ID=00000000-0000-4000-8000-000000000001
# IIKO_CLIENT_SECRET=vpzh-test-client-secret
# IIKO_ORGANIZATION_ID=3e41b6b4-9f43-4f65-8e5d-0c1c4c2f9a10
# IIKO_TERMINAL_GROUP_ID=4c6d5f37-bda2-4ed1-b48e-1b4fa7028f21
# IIKO_PRODUCT_MAPPING={"1":"10000000-0000-4000-8000-000000000001"}
# Required for paid-order fulfillment; IDs must be reviewed against the target iiko account.
# IIKO_ORDER_TYPE_ID=5c4d5e86-5f6c-46ae-8dd7-8e27b4ab1f31
# IIKO_PAYMENT_TYPE_ID=6a0d7c48-8f9e-4a12-9b33-4c5d6e7f8a41
