{
  "name": "@vse-pro-zhar/customer",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "dev": "pnpm --filter @vse-pro-zhar/contracts build && pnpm --filter @vse-pro-zhar/api-client build:root && pnpm run dev:root",
    "dev:root": "expo start --web --localhost --port 8082",
    "build": "pnpm --filter @vse-pro-zhar/contracts build && pnpm --filter @vse-pro-zhar/api-client build:root && pnpm run build:root",
    "build:root": "expo export --platform web",
    "typecheck": "pnpm --filter @vse-pro-zhar/contracts build && pnpm --filter @vse-pro-zhar/api-client build:root && pnpm run typecheck:root",
    "typecheck:root": "tsc --project tsconfig.json --noEmit",
    "lint": "eslint src test --max-warnings 0",
    "test": "pnpm --filter @vse-pro-zhar/contracts build && pnpm --filter @vse-pro-zhar/api-client build:root && pnpm run test:root",
    "test:root": "vitest run"
  },
  "dependencies": {
    "@expo/metro-runtime": "~57.0.15",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@vse-pro-zhar/api-client": "workspace:*",
    "@vse-pro-zhar/contracts": "workspace:*",
    "expo": "~57.0.19",
    "expo-constants": "~57.0.17",
    "expo-linking": "~57.0.9",
    "expo-notifications": "57.0.17",
    "expo-router": "~57.0.18",
    "expo-secure-store": "~57.0.3",
    "expo-status-bar": "57.0.1",
    "expo-updates": "~57.0.21",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "5.7.0",
    "react-native-screens": "4.26.0",
    "react-native-web": "0.21.2",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@expo/ngrok": "^4.1.3",
    "@types/node": "24.13.3",
    "@types/react": "19.2.4",
    "@types/react-dom": "19.2.5",
    "@types/react-test-renderer": "19.1.0",
    "react-test-renderer": "19.2.3",
    "vitest": "4.1.11"
  }
}
