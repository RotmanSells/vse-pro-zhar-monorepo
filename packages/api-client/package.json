{
  "name": "@vse-pro-zhar/api-client",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "pnpm --filter @vse-pro-zhar/contracts build && pnpm run build:root",
    "build:root": "tsc --project tsconfig.build.json",
    "typecheck": "pnpm --filter @vse-pro-zhar/contracts build && pnpm run typecheck:root",
    "typecheck:root": "tsc --project tsconfig.json --noEmit",
    "lint": "eslint src test --max-warnings 0",
    "test": "pnpm --filter @vse-pro-zhar/contracts build && pnpm run test:root",
    "test:root": "vitest run"
  },
  "dependencies": {
    "@vse-pro-zhar/contracts": "workspace:*"
  },
  "devDependencies": {
    "vitest": "4.1.11"
  }
}
